<test name="edge_grid_banner" use-rounding="false">
  <viewport width="320px" height="40px"/>
  <input>
    <div display="grid" position="relative" width="320px" height="40px" column-gap="10px"
         grid-template-columns="repeat(auto-fit, minmax(90px, 1fr))" grid-template-rows="20px 20px">
      <div grid-row-start="1" grid-column-start="1"/>
      <div grid-row-start="2" grid-row-end="3" grid-column-start="1" grid-column-end="-1" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="320" height="40" resolved-columns="100px 100px 100px">
      <node x="0" y="0" width="100" height="20"/>
      <node x="0" y="20" width="320" height="10"/>
    </node>
  </expectations>
</test>
