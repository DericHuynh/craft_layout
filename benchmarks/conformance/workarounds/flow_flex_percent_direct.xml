<test name="flow_flex_percent_direct" use-rounding="false">
  <!-- https://github.com/philipwalton/flexbugs/issues/197 | The grandchild fills the space left below a 20px header. -->
  <viewport width="400px" height="400px" />
  <input>
    <div display="flex" width="240px" height="100px" flex-direction="column">
      <div display="block" height="20px" flex-shrink="0" />
      <div display="block" flex-grow="1" flex-shrink="1" flex-basis="auto">
        <div display="block" height="100%" />
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="240" height="100">
      <node x="0" y="0" width="240" height="20" />
      <node x="0" y="20" width="240" height="80">
        <node x="0" y="0" width="240" height="80" />
      </node>
    </node>
  </expectations>
</test>
