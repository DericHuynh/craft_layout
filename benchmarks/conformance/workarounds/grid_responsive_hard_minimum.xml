<test name="grid_responsive_hard_minimum" use-rounding="false">
  <viewport width="90px" height="20px"/>
  <input>
    <div display="grid" width="90px" height="20px" column-gap="10px"
         grid-template-columns="repeat(auto-fit, minmax(120px, 1fr))">
      <div height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="90" height="20" resolved-columns="120px" resolved-rows="20px">
      <node x="0" y="0" width="120" height="20"/>
    </node>
  </expectations>
</test>
