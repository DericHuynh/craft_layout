<test name="flex_cards_outer_padding" use-rounding="false">
  <!-- Craft gives the cards equal outer widths. For content-box flex: 1 with 18px side padding on the middle card, Chromium 83 measured x=0, 88, 212 and widths 88, 124, 88. -->
  <viewport width="400px" height="400px"/>
  <input>
    <div display="flex" direction="ltr" position="absolute" width="300px" height="40px">
      <div display="flex" direction="ltr" position="relative" flex-basis="0%" flex-grow="1" flex-shrink="1" box-sizing="content-box">
        <div display="flex" direction="ltr" position="relative" flex-basis="0%" flex-grow="1" flex-shrink="1" box-sizing="content-box"/>
      </div>
      <div display="flex" direction="ltr" position="relative" flex-basis="0%" flex-grow="1" flex-shrink="1" box-sizing="content-box" padding-left="18px" padding-right="18px">
        <div display="flex" direction="ltr" position="relative" flex-basis="0%" flex-grow="1" flex-shrink="1" box-sizing="content-box"/>
      </div>
      <div display="flex" direction="ltr" position="relative" flex-basis="0%" flex-grow="1" flex-shrink="1" box-sizing="content-box">
        <div display="flex" direction="ltr" position="relative" flex-basis="0%" flex-grow="1" flex-shrink="1" box-sizing="content-box"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="40">
      <node x="0" y="0" width="100" height="40">
        <node x="0" y="0" width="100" height="40"/>
      </node>
      <node x="100" y="0" width="100" height="40">
        <node x="18" y="0" width="64" height="40"/>
      </node>
      <node x="200" y="0" width="100" height="40">
        <node x="0" y="0" width="100" height="40"/>
      </node>
    </node>
  </expectations>
</test>
