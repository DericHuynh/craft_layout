+use std::time::{Duration, Instant};
+
+const SAMPLES: usize = 21;
+const BATCH_NS: u128 = 4_000_000;
+
+struct BenchmarkId<'a> {
+    name: &'a str,
+    engine: &'a str,
+}
+impl<'a> BenchmarkId<'a> {
+    fn new(name: &'a str, engine: &'a str) -> Self { Self { name, engine } }
+}
+
+struct PairGroup<'a> {
+    root: &'a LayoutNode,
+    filter: Option<&'a str>,
+    warm_batches: bool,
+}
+
+impl PairGroup<'_> {
+    fn bench_function(&mut self, id: BenchmarkId<'_>, run: impl FnOnce(&mut PairBencher<'_>)) {
+        if id.engine == "keru_layout"
+            || self.filter.is_some_and(|value| !format!("{}/{}", id.name, id.engine).contains(value))
+        {
+            return;
+        }
+        let width = root_size(&self.root.width);
+        let height = root_size(&self.root.height);
+        if let Some(reference) = KeruLayoutTree::new(self.root, width, height) {
+            run(&mut PairBencher { id, reference, warm_batches: self.warm_batches });
+        }
+    }
+}
+
+struct PairBencher<'a> {
+    id: BenchmarkId<'a>,
+    reference: KeruLayoutTree,
+    warm_batches: bool,
+}
+
+fn timed_reference(reference: &mut KeruLayoutTree) -> Duration {
+    reference.mark_all_dirty();
+    let start = Instant::now();
+    reference.compute_layout();
+    start.elapsed()
+}
+
+fn batch(run: &mut impl FnMut() -> Duration, iterations: usize, warm: bool) -> f64 {
+    if warm { let _ = run(); }
+    let elapsed: Duration = (0..iterations).map(|_| run()).sum();
+    elapsed.as_nanos() as f64 / iterations as f64
+}
+
+fn iterations(run: &mut impl FnMut() -> Duration) -> usize {
+    let mut warm = [0; 5];
+    for elapsed in &mut warm {
+        *elapsed = run().as_nanos().max(1);
+    }
+    warm.sort_unstable();
+    (BATCH_NS / warm[2]).clamp(1, 20_000) as usize
+}
+
+fn iter_timed(bencher: &mut PairBencher<'_>, mut peer: impl FnMut() -> Duration) {
+    let mut reference = || timed_reference(&mut bencher.reference);
+    let peer_iterations = iterations(&mut peer);
+    let reference_iterations = iterations(&mut reference);
+    let warm = bencher.warm_batches;
+    for sample in 0..SAMPLES {
+        let (keru, other) = if sample % 2 == 0 {
+            (batch(&mut reference, reference_iterations, warm), batch(&mut peer, peer_iterations, warm))
+        } else {
+            let other = batch(&mut peer, peer_iterations, warm);
+            (batch(&mut reference, reference_iterations, warm), other)
+        };
+        println!("{}\t{}\t{}\t{}\t{}\t{}", bencher.id.name, bencher.id.engine,
+                 sample, keru, other, other / keru);
+    }
+}
+
+fn bench_layout<T>(
+    bencher: &mut PairBencher<'_>,
+    tree: &mut Option<T>,
+    build: impl FnOnce() -> T,
+    mut invalidate: impl FnMut(&mut T),
+    mut layout: impl FnMut(&mut T),
+) {
+    let tree = tree.get_or_insert_with(build);
+    iter_timed(bencher, || {
+        invalidate(tree);
+        let start = Instant::now();
+        layout(tree);
+        start.elapsed()
+    });
+}
